; NPT equilibration, 500 ps at 300 K and 1 bar, heavy atoms restrained
define          = -DPOSRES
integrator      = md
dt              = 0.002
nsteps          = 250000
nstxout-compressed = 5000
nstenergy       = 500
nstlog          = 5000
continuation    = yes
constraints     = h-bonds
constraint-algorithm = lincs
lincs-iter      = 1
lincs-order     = 4
cutoff-scheme   = Verlet
nstlist         = 20
rcoulomb        = 1.0
rvdw            = 1.0
coulombtype     = PME
pme-order       = 4
fourierspacing  = 0.12
DispCorr        = EnerPres
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau-t           = 0.1 0.1
ref-t           = 300 300
pcoupl          = C-rescale
pcoupltype      = isotropic
tau-p           = 2.0
ref-p           = 1.0
compressibility = 4.5e-5
refcoord-scaling = com
pbc             = xyz
gen-vel         = no
