; NVT equilibration, 100 ps at 300 K, heavy atoms restrained
define          = -DPOSRES
integrator      = md
dt              = 0.002
nsteps          = 50000
nstxout-compressed = 5000
nstenergy       = 500
nstlog          = 5000
continuation    = no
constraints     = h-bonds
constraint-algorithm = lincs
lincs-iter      = 1
lincs-order     = 4
cutoff-scheme   = Verlet
nstlist         = 20
rcoulomb        = 1.0
rvdw            = 1.0
coulombtype     = PME
pme-order       = 4
fourierspacing  = 0.12
DispCorr        = EnerPres
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau-t           = 0.1 0.1
ref-t           = 300 300
pcoupl          = no
pbc             = xyz
gen-vel         = yes
gen-temp        = 300
gen-seed        = -1
